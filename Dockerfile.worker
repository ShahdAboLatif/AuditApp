FROM php:8.4-cli

RUN apt-get update && apt-get install -y \
    git zip unzip curl ca-certificates \
    libzip-dev libpng-dev libonig-dev \
    default-mysql-client \
    supervisor \
 && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-install -j"$(nproc)" \
    bcmath gd mbstring pcntl pdo_mysql zip

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY supervisord-worker.conf /etc/supervisor/supervisord.conf
RUN mkdir -p /var/log/supervisor

COPY docker-entrypoint-worker.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["docker-entrypoint.sh"]
